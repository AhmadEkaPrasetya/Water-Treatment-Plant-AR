  m_Script: {fileID: 11500000, guid: 334a8316a0a91c64e9f1223a851055fd, type: 3}
  m_Name: BadgeCatalog
  m_EditorClassIdentifier: Assembly-CSharp::WTP.Progress.BadgeCatalog
  badges:
  - id: penjaga_intake
    title: Penjaga Intake
    description: Dapat 3 bintang di level Intake.
    color: {r: 0.35, g: 0.7, b: 0.85, a: 1}
  - id: ahli_koagulasi
    title: Ahli Koagulasi
    description: Dapat 3 bintang di level Koagulasi.
    color: {r: 0.55, g: 0.75, b: 0.95, a: 1}
  - id: operator_muda
    title: Operator Muda
    description: Selesaikan ke-7 level Belajar.
    color: {r: 0.3, g: 0.75, b: 0.45, a: 1}
  - id: bintang_sempurna
    title: Bintang Tirtapura
    description: Kumpulkan 21 bintang di Bagian Belajar.
    color: {r: 1, g: 0.84, b: 0.29, a: 1}
  - id: anti_gapura
    title: Anti Gapura
    description: Selesaikan satu level Rakit tanpa memasang kartu jebakan Pak Wacana.
    color: {r: 0.95, g: 0.55, b: 0.3, a: 1}
  - id: arsitek_wtp
    title: Arsitek WTP
    description: Selesaikan ke-3 level Rakit WTP.
    color: {r: 0.7, g: 0.55, b: 0.9, a: 1}
  - id: detektif_jeli
    title: Detektif Jeli
    description: Pecahkan satu kasus Detektif dengan skor 100.
    color: {r: 0.9, g: 0.4, b: 0.55, a: 1}
  - id: detektif_hulu
    title: Detektif Hulu
    description: Bongkar sumber pencemaran di hulu sungai (kasus terakhir).
    color: {r: 0.55, g: 0.45, b: 0.3, a: 1}
  - id: penyelamat_tirtapura
    title: Penyelamat Tirtapura
    description: Selesaikan Operator Shift musim asap.
    color: {r: 0.2, g: 0.6, b: 1, a: 1}
