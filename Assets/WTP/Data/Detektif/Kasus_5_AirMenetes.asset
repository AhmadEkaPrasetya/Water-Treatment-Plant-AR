  m_Script: {fileID: 11500000, guid: 8425aae45154a5a4aa4dab1bacd3c896, type: 3}
  m_Name: Kasus_5_AirMenetes
  m_EditorClassIdentifier: Assembly-CSharp::WTP.Gameplay.Detektif.CaseData
  title: Air Keran Cuma Menetes
  reporter: Bu Wati
  report: Air di rumah saya jernih, tapi keluarnya cuma menetes. Ngisi ember setengah jam!
  intro:
  - speaker: {fileID: 11400000, guid: af4daadbae8426347b28771114757740, type: 2}
    text: Kali ini airnya jernih, tapi alirannya lemah. Reservoir hampir kosong. Apa penyebabnya, {player}?
  outro:
  - speaker: {fileID: 11400000, guid: af4daadbae8426347b28771114757740, type: 2}
    text: 'Mantap! Reservoir kosong itu cuma akibatnya. Penyebabnya ada di hulunya: saringan yang tersumbat.'
  faultyUnit: 4
  units:
  - unit: 0
    measurements:
    - label: Kekeruhan air sungai
