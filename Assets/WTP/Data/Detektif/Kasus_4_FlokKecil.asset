  m_EditorClassIdentifier: Assembly-CSharp::WTP.Gameplay.Detektif.CaseData
  title: Tawas Sudah Cukup, Air Tetap Keruh
  reporter: Pak RT Bambang
  report: Kata petugas, tawasnya sudah ditambah, tapi air di kompleks kami tetap keruh.
  intro:
  - speaker: {fileID: 11400000, guid: af4daadbae8426347b28771114757740, type: 2}
    text: Hati-hati, {player}. Petugas sudah menambah tawas tapi tidak berhasil. Jangan langsung ikut-ikutan, periksa datanya dulu!
  outro:
  - speaker: {fileID: 11400000, guid: af4daadbae8426347b28771114757740, type: 2}
    text: Keren! Menambah tawas tidak akan menolong kalau pengaduknya mati. Itulah gunanya memeriksa data, bukan menebak.
  faultyUnit: 2
  units:
  - unit: 0
    measurements:
